aegis_prime/
│
├── cli/
│   ├── __init__.py
│   ├── main.py                 # entry point: aegis
│   ├── query_cmd.py           # aegis query ...
│   ├── builder/
│   │   ├── __init__.py
│   │   ├── interactive.py     # guided CLI flow (your builder)
│   │   ├── prompts.py         # all input prompts + formatting
│   │   ├── session.py         # stateful session handling
│   │   └── autocomplete.py    # (future: fuzzy field search)
│
│
├── core/
│   ├── __init__.py
│   ├── ast/
│   │   ├── __init__.py
│   │   ├── nodes.py           # Select, Where, OrderBy, etc.
│   │   ├── state.py           # QueryState (or AST builder state)
│   │   └── builder.py         # AST construction helpers
│   │
│   ├── compiler/
│   │   ├── __init__.py
│   │   ├── aql_compiler.py    # AST → AQL string
│   │   └── formatter.py       # string formatting helpers
│   │
│   ├── engine/
│   │   ├── __init__.py
│   │   ├── executor.py        # runs query against data
