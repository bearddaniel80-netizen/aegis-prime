│       ├── mongo.py
│       └── neo4j.py
│
│
├── api/
│   ├── __init__.py
│   ├── query_service.py       # programmatic API (non-CLI)
│   └── response_models.py
│
│
├── utils/
│   ├── __init__.py
│   ├── parsing.py
│   ├── validation.py
│   └── errors.py
